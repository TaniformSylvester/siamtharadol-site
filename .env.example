# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# Local dev: SQLite, zero setup required.
DATABASE_URL="file:./dev.db"
# Production example (Postgres): postgresql://user:password@host:5432/siamtharadol

# Enables the built-in sandbox payment simulator (/book/pay, /api/payments/simulate) so the
# full booking flow can be tested without a real 2C2P account. MUST be "false" in production.
PAYMENT_SANDBOX_MODE="true"

# --- Admin dashboard ---
ADMIN_EMAIL="admin@example.com"
# Base64 of a bcrypt hash of the admin password. Base64-encoded because a raw bcrypt hash
# (e.g. $2b$10$...) contains $-sequences that Next's env-file loader tries to expand as
# variable references, silently corrupting it. Generate with:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync('your-password', 10)).toString('base64'))"
ADMIN_PASSWORD_HASH_B64=""
ADMIN_SESSION_SECRET="generate-a-long-random-string"

# --- 2C2P payment gateway (sandbox by default) ---
# Get these from the 2C2P merchant portal / sandbox onboarding. Never put them
# in frontend code — they are only ever read on the server (see src/lib/payments/2c2p.ts).
TWOC2P_MERCHANT_ID=""
TWOC2P_SECRET=""
TWOC2P_API_URL="https://sandbox-pgw.2c2p.com"
TWOC2P_RETURN_URL="http://localhost:3000/api/payments/return"
TWOC2P_BACKEND_URL="http://localhost:3000/api/payments/webhook"
